# ApplyPilot AI Environment Configuration

# Server
FLASK_ENV=development
FLASK_APP=backend/run.py
PORT=5000
SECRET_KEY=applypilot_development_secret_key_change_in_production
JWT_SECRET_KEY=applypilot_jwt_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24

# Database
DATABASE_URL=sqlite:///./storage/applypilot.db

# Storage Paths
STORAGE_PATH=./storage
RESUME_STORAGE_PATH=./storage/resumes
LOGS_STORAGE_PATH=./storage/logs

# Automation Defaults
AUTOMATION_HEADLESS=false
MAX_CONCURRENT_SESSIONS=1
DEFAULT_APPLICATION_DELAY_SECONDS=5

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
